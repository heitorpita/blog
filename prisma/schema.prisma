generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum SessionMode {
  FREE
  POMODORO
}

enum XpSource {
  TASK
  TOPIC
  SESSION
  STREAK
  ADJUSTMENT
}

model Subject {
  id      String @id
  code    String
  name    String
  hours   Int
  teacher String
  color   String

  topics   Topic[]
  tasks    Task[]
  sessions StudySession[]
  posts    JournalPost[]
  xpEvents XpEvent[]

  createdAt DateTime @default(now())
}

model Topic {
  id          String    @id @default(cuid())
  title       String
  order       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  tasks    Task[]
  xpEvents XpEvent[]

  @@index([subjectId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  xp          Int          @default(10)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId String?

  xpEvents XpEvent[]

  @@index([subjectId])
  @@index([topicId])
}

model StudySession {
  id              String      @id @default(cuid())
  mode            SessionMode @default(FREE)
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  xpEarned        Int
  createdAt       DateTime    @default(now())

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  xpEvents XpEvent[]

  @@index([subjectId])
  @@index([endedAt])
}

model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId String?

  links JournalLink[]

  @@index([subjectId])
}

// Backlink estilo Obsidian: cada `[[Alvo]]` no markdown de um post vira uma linha.
// Guarda só o texto do alvo, sem FK — a resolução (post? matéria? tópico?) acontece
// na hora de montar o grafo, contra os dados atuais. Assim um link nunca fica
// apontando para um título que já mudou, e links para algo que ainda não existe
// continuam visíveis como "não resolvidos", igual ao Obsidian.
model JournalLink {
  id     String @id @default(cuid())
  target String

  fromPost   JournalPost @relation(fields: [fromPostId], references: [id], onDelete: Cascade)
  fromPostId String

  @@index([fromPostId])
}

// Ledger de XP: fonte única de verdade. O XP total é SUM(amount), então não
// existe contador separado que possa divergir das linhas de origem.
// Estornar XP (desmarcar tarefa/tópico) apaga o evento em vez de gravar um
// evento negativo, para o feed não encher de ruído.
model XpEvent {
  id          String   @id @default(cuid())
  source      XpSource
  amount      Int
  description String
  createdAt   DateTime @default(now())

  // SetNull, não Cascade: apagar uma matéria antiga não pode apagar o esforço
  // que ela custou. Com Cascade o total caía, o nível REGREDIA e o cérebro
  // encolhia — um ledger que perde linhas não é um ledger. `getXpBySubject` já
  // trazia o fallback "Matéria removida", que até agora era código morto.
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId String?

  /**
   * Marco de streak (7, 30, 100...) que este evento concedeu.
   * A idempotência do bônus dependia de casar a string da descrição, então
   * renomear "Streak de 7 dias" reconcederia todos os bônus já dados. Agora a
   * chave é o dado, com unicidade garantida pelo banco.
   */
  milestoneDays Int?

  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String?

  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId String?

  session   StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?

  // Uma tarefa/tópico concede XP no máximo uma vez. É a trava definitiva contra
  // duplo clique e contra qualquer caminho de código futuro que esqueça a
  // checagem: no Postgres um índice único trata NULLs como distintos, então
  // eventos de outras origens (sessão, streak) continuam livres.
  @@unique([taskId])
  @@unique([topicId])
  @@unique([milestoneDays])
  @@index([createdAt])
  @@index([subjectId])
}
